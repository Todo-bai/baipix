---
import Dither from '../components/Dither.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import Logo from '../components/Logo.astro';
import PixelIcon from '../components/PixelIcon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Base from '../layouts/Base.astro';
import { APP_URL, REPO_URL } from '../links';

const base = import.meta.env.BASE_URL;
const STAR = ['...#...', '..###..', '#######', '.#####.', '..###..', '.##.##.', '.#...#.'];
const clone = 'git clone https://github.com/baipix/baipix.git\ncd baipix\nnpm install\nnpm run dev';

const features = [
  {
    title: 'Simple, light, familiar',
    text: "Layers on the left, tools at the bottom, properties on the right. If you use Figma, you'll find your way around right away.",
    icon: ['#######', '#.#...#', '#.#...#', '#.#...#', '#.#...#', '#.#...#', '#######'],
  },
  {
    title: 'Clean vector export',
    text: 'Every color becomes a single SVG path. Copy as SVG and paste it straight into Figma or Illustrator, or export a PNG from 1× to 32× with a live preview.',
    icon: ['##.....', '##.....', '..#....', '...#...', '....#..', '.....##', '.....##'],
  },
  {
    title: 'Pixel gap rendering',
    text: 'Space pixels apart for an LED or dot-matrix look, right on the canvas, and exported as real vector.',
    icon: ['#.#.#.#', '.......', '#.#.#.#', '.......', '#.#.#.#', '.......', '#.#.#.#'],
  },
  {
    title: 'Shading that follows the palette',
    text: 'Lighten and shade along the ramp of the color, with an optional hue shift, or adjust hue and saturation of the whole drawing in one pass.',
    icon: ['......#', '.....##', '....###', '...####', '..#####', '.######', '#######'],
  },
  {
    title: 'Palettes from anywhere',
    text: 'Nineteen classic palettes from Lospec, .hex and .gpl files from GIMP or Aseprite, or one built from your drawing. Drag swatches to reorder them.',
    icon: ['###.###', '###.###', '###.###', '.......', '###.###', '###.#.#', '###.###'],
  },
  {
    title: 'Pixel-perfect drawing',
    text: 'A pixel-perfect pencil, dithering, shapes from lines to stars, a fill, and an eyedropper with a loupe that shows the hex code.',
    icon: ['...#...', '..###..', '#######', '.#####.', '..###..', '.##.##.', '.#...#.'],
  },
  {
    title: 'Symmetry, anywhere',
    text: 'Mirror left-right, top-bottom or both, around axes you drag anywhere on the canvas. Tile preview shows seamless patterns as you draw.',
    icon: ['#..#..#', '##.#.##', '###.###', '###.###', '###.###', '##.#.##', '#..#..#'],
  },
  {
    title: 'Layers like a design tool',
    text: 'Lock, hide, show only one, select several with Shift, drag them around, merge or flatten. Deleted by mistake? Undo is right in the toast.',
    icon: ['#######', '.......', '.#####.', '.......', '..###..', '.......', '...#...'],
  },
  {
    title: 'Private by default',
    text: 'No account, no upload. Your drawings are saved in your browser as you go, several files at once, and never leave your device.',
    icon: ['..###..', '.#...#.', '.#...#.', '#######', '###.###', '###.###', '#######'],
  },
];
---

<Base
  title="Baipix, pixel art for designers"
  description="A free, open source pixel art editor with the interface of a modern design tool. Draw pixel by pixel, export clean vector."
>
  <header class="nav container">
    <a class="brand" href={base} aria-label="Baipix home">
      <Logo size={18} />
      <span>Baipix</span>
    </a>
    <nav class="nav-links">
      <a href="#features">Features</a>
      <a href="#gallery">Gallery</a>
      <a href="#install">Get started</a>
    </nav>
    <a class="btn btn-small star" href={REPO_URL} aria-label="Star Baipix on GitHub">
      <PixelIcon rows={STAR} size={13} />
      <span>Star</span>
      <span class="star-count" data-stars hidden></span>
    </a>
    <ThemeToggle />
    <a class="btn btn-dark btn-small" href={APP_URL}>
      Open the editor
    </a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="container hero-inner">
        <h1>
          Pixel art has never been this easy<span class="pixel-dot" aria-hidden="true"></span>
        </h1>
        <p class="lead">
          Baipix is a pixel art editor with the interface of a modern design tool. Draw pixel by pixel, then
          drop clean vector straight into your design files.
        </p>
        <div class="actions">
          <a class="btn btn-dark" href={APP_URL}>
            Open the editor
          </a>
          <a class="btn" href={REPO_URL}>
            View on GitHub
          </a>
        </div>
      </div>
      <div class="container">
        <figure class="shot">
          <img
            class="for-light"
            src={`${base}screenshot-light.png`}
            width="1440"
            height="900"
            alt="The Baipix editor with a pixel art sunset: files and layers on the left, tools at the bottom, properties on the right."
          />
          <img
            class="for-dark"
            src={`${base}screenshot-dark.png`}
            width="1440"
            height="900"
            alt="The Baipix editor with a pixel art sunset: files and layers on the left, tools at the bottom, properties on the right."
            loading="lazy"
          />
          <span class="shot-pixel" aria-hidden="true"></span>
        </figure>
      </div>
    </section>

    <section id="install" class="install container">
      <h2>Up and running in seconds.</h2>
      <div class="install-grid">
        <div class="card">
          <h3>Use it in your browser</h3>
          <p class="muted">Nothing to install, no account. Your drawings stay on your device.</p>
          <a class="btn btn-dark" href={APP_URL}>
            Open the editor
          </a>
        </div>
        <div class="card">
          <h3>Run it locally</h3>
          <p class="muted">Clone the repository and start the dev server. Requires Node.js.</p>
          <div class="code">
            <pre><code>{clone}</code></pre>
            <button class="copy" type="button" data-copy={clone}>
              Copy
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="features container">
      <h2>Everything you need. Nothing you don't.</h2>
      <div class="feature-grid">
        {features.map((f) => (
          <article class="feature">
            <PixelIcon rows={f.icon} size={24} />
            <h3>{f.title}</h3>
            <p class="muted">{f.text}</p>
          </article>
        ))}
      </div>
    </section>

    <Gallery />

    <section class="cta container">
      <div class="cta-card">
        <Dither class="cta-dither" cols={28} rows={10} cell={8} />
        <h2>Draw your first pixel.</h2>
        <div class="actions">
          <a class="btn btn-light" href={APP_URL}>
            Open the editor
          </a>
          <a class="btn btn-ghost" href="#install">
            Run it locally
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // Star count from the GitHub API; the button works without it.
    fetch('https://api.github.com/repos/baipix/baipix')
      .then((r) => (r.ok ? r.json() : null))
      .then((repo) => {
        const el = document.querySelector<HTMLElement>('[data-stars]');
        if (!el || typeof repo?.stargazers_count !== 'number') return;
        el.textContent = new Intl.NumberFormat('en', { notation: 'compact' }).format(repo.stargazers_count);
        el.hidden = false;
      })
      .catch(() => {});

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Press Ctrl+C';
        }
        setTimeout(() => (button.textContent = 'Copy'), 1600);
      });
    }
  </script>
</Base>

<style>
  /* ---- Nav ---- */
  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    gap: 24px;
    margin-right: auto;
    font-size: 14px;
    color: var(--muted);
  }
  .nav-links a:hover {
    color: var(--text);
  }
  .star-count {
    padding-left: 8px;
    border-left: 1px solid var(--line);
    font: 500 13px/1 var(--mono);
    color: var(--muted);
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding: 72px 0 0;
    overflow: hidden;
  }
  /* A faint pixel grid, like an empty canvas, fading out around the title. */
  .hero-grid {
    position: absolute;
    inset: 0 0 35%;
    background-image: radial-gradient(circle at 1px 1px, var(--dots) 1px, transparent 1.5px);
    background-size: 16px 16px;
    /* A mask only uses the alpha channel: #000 means fully visible, not a color. */
    mask-image: radial-gradient(ellipse 60% 70% at 50% 35%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  h1 {
    max-width: 14ch;
    font-size: clamp(40px, 7vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  /* The final period is a single square pixel. */
  .pixel-dot {
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.06em;
    background: currentColor;
  }
  .lead {
    max-width: 580px;
    text-wrap: balance;
    margin-top: 24px;
    font-size: 18px;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }
  /*
   * A pixel frame, like the buttons: a 2px edge minus its corners (drawn with offset shadows, so the
   * escaping pixel outside isn't clipped), and a solid side underneath.
   */
  .shot {
    --edge: var(--line-strong);
    position: relative;
    /* Room below for the side: the hero clips whatever overflows it. */
    margin: 64px 0 12px;
    padding: 10px;
    border: 0;
    border-radius: 0;
    background: var(--surface);
    box-shadow:
      0 -2px 0 0 var(--edge),
      -2px 0 0 0 var(--edge),
      2px 0 0 0 var(--edge),
      0 2px 0 0 var(--edge),
      0 10px 0 0 var(--edge);
  }
  .shot img {
    width: 100%;
    height: auto;
    border-radius: 0;
  }
  /* The screenshot follows the site theme: the OS setting, or the visitor's pick. */
  .shot .for-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .shot .for-light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .shot .for-dark {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .shot .for-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .shot .for-dark {
    display: block;
  }
  /* The logo's escaping pixel, leaving the screenshot's corner. */
  .shot-pixel {
    position: absolute;
    top: -22px;
    right: -22px;
    width: 14px;
    height: 14px;
    /* Same tint as the frame it escaped from. */
    background: var(--line-strong);
  }

  /* ---- Sections ---- */
  section.install,
  section.features {
    padding-top: 120px;
  }
  h3 {
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  .install-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 40px;
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .card .btn {
    margin-top: auto;
  }
  /* Cards share their borders, like the feature grid. */
  .card + .card {
    border-left: 0;
  }
  .code {
    position: relative;
    width: 100%;
    margin-top: 4px;
    border-radius: var(--radius);
    background: var(--surface);
  }
  pre {
    margin: 0;
    padding: 16px 84px 16px 18px; /* room for the copy button */
    overflow-x: auto;
    font: 400 13px/1.7 var(--mono);
  }
  .copy {
    position: absolute;
    top: 10px;
    right: 10px;
    height: 28px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--bg);
    font: 500 12px/1 var(--mono);
    cursor: pointer;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 40px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 28px 36px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .feature h3 {
    margin-top: 12px;
  }
  .feature p {
    font-size: 15px;
  }

  /* ---- Final call to action ---- */
  .cta {
    padding-top: 120px;
  }
  .cta-card {
    position: relative;
    overflow: hidden;
    padding: 72px 48px;
    border-radius: var(--radius-lg);
    background: var(--cta-bg);
    color: var(--cta-text);
  }
  .cta-card .actions {
    justify-content: flex-start;
  }
  /* Child component: scoped styles need :global to reach it. */
  .cta-card :global(.cta-dither) {
    position: absolute;
    right: 0;
    bottom: 0;
    color: var(--cta-dither);
    pointer-events: none;
  }
  .btn-light {
    --side: var(--cta-button-side);
    border-color: var(--cta-button);
    background: var(--cta-button);
    color: var(--cta-bg);
  }
  .btn-light:hover {
    border-color: var(--cta-button-hover);
    background: var(--cta-button-hover);
  }
  .btn-light:focus-visible {
    outline-color: var(--cta-bg);
  }
  .btn-ghost {
    --side: var(--cta-ghost-line);
    border-color: var(--cta-ghost-line);
    background: transparent;
    color: var(--cta-text);
  }
  .btn-ghost:hover {
    border-color: var(--cta-ghost-line-hover);
    background: var(--cta-ghost-hover);
  }
  .btn-ghost:focus-visible {
    outline-color: var(--cta-text);
  }

  /* ---- Small screens ---- */
  @media (max-width: 860px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .nav-links,
    .star {
      display: none;
    }
    .nav {
      justify-content: space-between;
      gap: 12px;
    }
    .nav :global(.theme-toggle) {
      margin-left: auto;
    }
    .hero {
      padding-top: 40px;
    }
    .install-grid,
    .feature-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .card + .card {
      border-left: 1px solid var(--line);
      border-top: 0;
    }
    .shot {
      margin-top: 40px;
      padding: 6px;
    }
    .shot-pixel {
      display: none;
    }
    .cta-card {
      padding: 48px 24px 120px;
    }
  }
</style>
