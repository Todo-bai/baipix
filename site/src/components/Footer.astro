---
/** Site footer, shared by every page. */
import { LICENSE_URL, REPO_URL } from '../links';
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL;
---

<footer class="footer container">
  <a class="brand" href={base}>
    <Logo size={14} />
    <span>Baipix</span>
  </a>
  <nav class="footer-links">
    <a href={REPO_URL}>GitHub</a>
    <a href={LICENSE_URL}>MIT License</a>
  </nav>
  <p class="muted">© 2026 Baipix</p>
  <p class="muted trademark">Figma is a trademark of Figma, Inc. Baipix isn't affiliated with Figma.</p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 96px;
    padding: 28px 0 40px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .trademark {
    flex-basis: 100%;
    font-size: 12px;
  }
  .footer-links {
    display: flex;
    gap: 20px;
    margin-right: auto;
    color: var(--muted);
  }
  .footer-links a:hover {
    color: var(--text);
  }
</style>
