---
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

/*
 * A 1-bit scene, drawn in the text color so it follows the light and dark themes: a bomb falling
 * on a small city, a kid pointing at it from the street, and a shop sign that reads 404. Everything
 * is generated here, on a grid, with a fixed random seed so it looks the same on every build.
 */
const W = 112;
const H = 64;
const ink = Array.from({ length: H }, () => new Uint8Array(W));
const set = (x: number, y: number, v = 1) => {
  if (x >= 0 && y >= 0 && x < W && y < H) ink[y][x] = v;
};
const rect = (x: number, y: number, w: number, h: number, v = 1) => {
  for (let j = y; j < y + h; j++) for (let i = x; i < x + w; i++) set(i, j, v);
};
const frame = (x: number, y: number, w: number, h: number) => {
  rect(x, y, w, 1);
  rect(x, y + h - 1, w, 1);
  rect(x, y, 1, h);
  rect(x + w - 1, y, 1, h);
};
const stamp = (rows: string[], x0: number, y0: number, v = 1) =>
  rows.forEach((row, y) => [...row].forEach((c, x) => c === '#' && set(x0 + x, y0 + y, v)));

// Ordered dithering (Bayer 4 × 4): `level` 0..1 is how much ink a flat area gets.
const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
const dithered = (x: number, y: number, level: number) => level * 16 > BAYER[(y % 4) * 4 + (x % 4)] + 0.5;

// Deterministic randomness (mulberry32), for the windows.
let seed = 404;
const random = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

// Clouds: a few overlapping discs, outlined, with a dithered shadow on their lower half.
const clouds = [
  [
    [8, 12, 5],
    [14, 9, 6],
    [21, 12, 5],
    [15, 14, 5],
  ],
  [
    [92, 8, 4],
    [98, 6, 5],
    [104, 9, 4],
  ],
  [
    [40, 26, 3],
    [45, 24, 4],
    [50, 27, 3],
  ],
];
for (const cloud of clouds) {
  const inside = (x: number, y: number) => cloud.some(([cx, cy, r]) => (x - cx) ** 2 + (y - cy) ** 2 <= r * r);
  const top = Math.min(...cloud.map(([, cy, r]) => cy - r));
  const bottom = Math.max(...cloud.map(([, cy, r]) => cy + r));
  for (let y = 0; y < H; y++)
    for (let x = 0; x < W; x++) {
      if (!inside(x, y)) continue;
      const edge = !inside(x - 1, y) || !inside(x + 1, y) || !inside(x, y - 1) || !inside(x, y + 1);
      const shade = Math.max(0, (y - top) / (bottom - top) - 0.5) * 1.1; // 0 at mid-height, ~0.55 at the bottom
      if (edge || dithered(x, y, shade)) set(x, y);
    }
}

// The bomb, falling: a disc with a highlight, a neck, a fuse, and dashed lines above it.
const bomb = { x: 74, y: 19, r: 7 };
for (let y = -bomb.r; y <= bomb.r; y++)
  for (let x = -bomb.r; x <= bomb.r; x++) if (x * x + y * y <= bomb.r * bomb.r + 2) set(bomb.x + x, bomb.y + y);
stamp(['..###', '.#...', '#....', '#....'], bomb.x - 5, bomb.y - 5, 0);
rect(bomb.x + 3, bomb.y - 8, 3, 2);
stamp(['..#', '.#.', '#..'], bomb.x + 5, bomb.y - 11);
for (const dx of [-4, 0, 4])
  for (let y = 1; y < bomb.y - bomb.r - 3 - Math.abs(dx) / 2; y++) if (y % 4 < 2) set(bomb.x + dx, y);

// Back buildings: lighter, a dither instead of outlines, for depth.
const GROUND = 50;
for (const [x, top, w] of [
  [0, 30, 12],
  [26, 27, 9],
  [58, 31, 11],
  [86, 25, 10],
  [102, 33, 10],
])
  for (let y = top; y < GROUND; y++) for (let i = x; i < x + w; i++) if (dithered(i, y, 0.25)) set(i, y);

// Front buildings: outlined, with a grid of windows, some of them lit (left empty).
const front = [
  [6, 36, 16],
  [21, 32, 12],
  [36, 38, 18],
  [53, 34, 14],
  [70, 40, 16],
  [89, 30, 14],
];
for (const [x, top, w] of front) {
  rect(x, top, w, GROUND - top, 0);
  frame(x, top, w, GROUND - top + 1);
  rect(x - 1, top, w + 2, 1); // roof ledge
  for (let y = top + 3; y < GROUND - 6; y += 4)
    for (let i = x + 2; i < x + w - 3; i += 4) if (random() > 0.25) rect(i, y, 2, 2);
  rect(x + Math.floor(w / 2) - 1, GROUND - 4, 3, 4); // door
}
// A water tank and an antenna on the roofs.
stamp(['.###.', '#####', '#...#', '#...#'], 24, 28);
rect(96, 24, 1, 6);
rect(94, 26, 5, 1);
// The shop sign: 404 in light digits on a dark board.
const signX = 72;
const signY = 41;
rect(signX, signY, 13, 7);
const DIGITS = { 4: ['#.#', '#.#', '###', '..#', '..#'], 0: ['###', '#.#', '#.#', '#.#', '###'] };
['4', '0', '4'].forEach((d, i) => stamp(DIGITS[d as '4' | '0'], signX + 1 + i * 4, signY + 1, 0));

// Street furniture: two lamps between buildings, a tree, and a striped awning over the 404 shop.
// Lamps and tree get a clear 1 px outline, so they read against the facades.
const drawWithOutline = (pixels: [number, number][]) => {
  for (const [x, y] of pixels) for (const [dx, dy] of [[-1, 0], [1, 0], [0, -1], [0, 1]]) set(x + dx, y + dy, 0);
  for (const [x, y] of pixels) set(x, y);
};
for (const lx of [34, 68]) {
  const lamp: [number, number][] = [];
  for (let y = GROUND - 9; y < GROUND; y++) lamp.push([lx, y]);
  for (const [dx, dy] of [[-1, -12], [0, -12], [1, -12], [-1, -11], [1, -11], [-1, -10], [0, -10], [1, -10]])
    lamp.push([lx + dx, GROUND + dy]);
  drawWithOutline(lamp);
}
const tree: [number, number][] = [];
for (let y = -4; y <= 4; y++)
  for (let x = -4; x <= 4; x++) {
    const d = x * x + y * y;
    if (d <= 18 && (d >= 11 || dithered(107 + x, 39 + y, 0.45))) tree.push([107 + x, 39 + y]);
  }
for (let y = 43; y < GROUND; y++) tree.push([107, y]);
drawWithOutline(tree);
for (let x = 71; x < 86; x++) set(x, 40, x % 2);
rect(71, 39, 15, 1);
stamp(['#.#', '.#.'], 30, 6);
stamp(['#.#', '.#.'], 35, 4);

// Street: the sidewalk's edge, a dashed center line, and a road that darkens toward the bottom.
rect(0, GROUND, W, 1);
rect(0, GROUND + 3, W, 1);
for (let x = 0; x < W; x++) if (x % 8 < 4) set(x, GROUND + 7);
for (let y = GROUND + 10; y < H; y++)
  for (let x = 0; x < W; x++) if (dithered(x, y, ((y - GROUND - 9) / (H - GROUND - 9)) * 0.6)) set(x, y);

// The kid on the sidewalk, pointing at the bomb, with a clear outline so he reads on the facade.
const KID = [
  '..###...',
  '.#####..',
  '.#.#.#.#',
  '.#####.#',
  '..###.#.',
  '.#####..',
  '#.###...',
  '..###...',
  '..#.#...',
  '.##.##..',
];
const kid = { x: 12, y: GROUND - 7 };
KID.forEach((row, y) =>
  [...row].forEach((c, x) => {
    if (c !== '#') return;
    for (const [dx, dy] of [
      [-1, 0],
      [1, 0],
      [0, -1],
      [0, 1],
    ])
      set(kid.x + x + dx, kid.y + y + dy, 0);
  }),
);
stamp(KID, kid.x, kid.y);

// Two frames for the spark on the fuse.
const spark = (rows: string[]) => {
  const g = Array.from({ length: H }, () => new Uint8Array(W));
  rows.forEach((row, y) =>
    [...row].forEach((c, x) => c === '#' && (g[bomb.y - 14 + y][bomb.x + 7 + x] = 1)),
  );
  return g;
};
const sparkA = spark(['#.#', '.#.', '#.#']);
const sparkB = spark(['.#.', '###', '.#.']);

// One rectangle per horizontal run of ink keeps the SVG small.
const path = (g: Uint8Array[]) =>
  g
    .map((row, y) => {
      let d = '';
      for (let x = 0; x < W; x++) {
        if (!row[x]) continue;
        const start = x;
        while (x < W && row[x]) x++;
        d += `M${start} ${y}h${x - start}v1h-${x - start}z`;
      }
      return d;
    })
    .join('');
---

<Base title="Page not found · Baipix" description="This page doesn't exist. Head back to the Baipix home page.">
  <header class="top container">
    <a class="brand" href={base} aria-label="Baipix home">
      <Logo size={18} />
      <span>Baipix</span>
    </a>
    <ThemeToggle />
  </header>

  <main class="lost container">
    <svg
      class="scene"
      viewBox={`0 0 ${W} ${H}`}
      shape-rendering="crispEdges"
      role="img"
      aria-label="A bomb falling on a small pixel city, above a shop sign that reads 404"
    >
      <path fill="currentColor" d={path(ink)}></path>
      <path class="spark spark-a" fill="currentColor" d={path(sparkA)}></path>
      <path class="spark spark-b" fill="currentColor" d={path(sparkB)}></path>
    </svg>
    <p class="code">Error 404</p>
    <h1>This page blew up.</h1>
    <p class="muted">It doesn't exist, or it moved. Let's get you back somewhere safe.</p>
    <a class="btn btn-dark" href={base}>Back to home</a>
  </main>
</Base>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 32px 0 96px;
    text-align: center;
  }
  /* Whole multiples of the grid keep every pixel crisp. */
  .scene {
    width: 560px;
    height: 320px;
    max-width: 100%;
    color: var(--text);
  }
  .code {
    margin-top: 36px;
    font: 500 13px/1 var(--mono);
    color: var(--muted);
  }
  h1 {
    margin-top: 12px;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
  }
  .lost p.muted {
    max-width: 420px;
    margin-top: 12px;
    font-size: 17px;
  }
  .lost .btn {
    margin-top: 32px;
  }
  /* The spark flickers between two frames, like an old game. */
  .spark-b {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .spark-a {
      animation: spark 0.5s steps(1) infinite;
    }
    .spark-b {
      animation: spark 0.5s steps(1) infinite -0.25s;
    }
  }
  @keyframes spark {
    0% {
      visibility: visible;
    }
    50% {
      visibility: hidden;
    }
  }
  @media (max-width: 640px) {
    .scene {
      width: 336px;
      height: 192px;
    }
  }
</style>
